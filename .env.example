# Required for live Monid parsing. Never expose this value to the browser.
MONID_API_KEY=
MONID_API_BASE_URL=https://api.monid.ai
MONID_PARSE_PROVIDER=
MONID_PARSE_ENDPOINT=
MONID_RUN_ID_PATH=
MONID_RUN_STATUS_PATH=
MONID_PROVIDER_STATUS_PATH=
MONID_RESULT_URL_PATH=
MONID_COST_VALUE_PATH=
MONID_COST_CURRENCY_PATH=
# Exact comma-separated artifact hosts; wildcards are not accepted.
MONID_ARTIFACT_HOST_ALLOWLIST=

# Required for live structured extraction and Q&A.
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-5.4-mini
OPENAI_QA_MODEL=gpt-5.4-mini
OPENAI_MAX_SERIALIZED_INPUT_BYTES=1200000
OPENAI_MAX_REQUEST_INPUT_BYTES=140000
OPENAI_MAX_INPUT_TOKENS=320000
OPENAI_MAX_OUTPUT_TOKENS=50000
OPENAI_RUN_RESERVE_MICRO_USD=495000
MONID_PARSE_RESERVE_MICRO_USD=4500

# Required in production. Local development falls back to an in-memory store.
DATABASE_URL=

# Vercel Private Blob. Vercel deployments can use project-scoped OIDC.
BLOB_READ_WRITE_TOKEN=
# Set only after credentialed verification that allowOverwrite=false signed PUTs
# cannot replace the zero-byte replay fence written by the server.
BLOB_REPLAY_FENCE_VALIDATED=false

# Public-demo abuse controls.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=
CRON_SECRET=
SESSION_SIGNING_SECRET=
IP_HASH_SECRET=
API_KEY_SHA256=

# Cost guardrails in USD micro-dollars.
MAX_RUN_COST_MICRO_USD=2000000
DAILY_COST_CAP_MICRO_USD=20000000
RUN_TTL_HOURS=24
GUEST_RUNS_PER_DAY=3
API_RUNS_PER_DAY=30
MAX_OUTSTANDING_UPLOAD_GRANTS=5
GUEST_UPLOAD_DOCUMENTS_PER_DAY=15
API_UPLOAD_DOCUMENTS_PER_DAY=150
GUEST_UPLOAD_BYTES_PER_DAY=393216000
API_UPLOAD_BYTES_PER_DAY=3932160000
GLOBAL_UPLOAD_BYTES_PER_DAY=5368709120

# Trusted absolute application origin for metadata and callbacks.
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
