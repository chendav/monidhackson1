# Required for live Monid parsing. Never expose this value to the browser.
MONID_API_KEY=
MONID_API_BASE_URL=https://api.monid.ai
MONID_PARSE_PROVIDER=
MONID_PARSE_ENDPOINT=
MONID_RUN_ID_PATH=
MONID_RUN_STATUS_PATH=
MONID_PROVIDER_STATUS_PATH=
MONID_RESULT_URL_PATH=
MONID_COST_VALUE_PATH=
MONID_COST_CURRENCY_PATH=
# Freeze these only from credentialed `/v1/inspect`. The hash is SHA-256 of
# the complete canonical stable-JSON response and is revalidated at runtime
# before paid POST; it is not a self-authored schema summary. GET-run costs use
# currency_major; POST-run billing values use micro_dollar.
MONID_COST_VALUE_UNIT=
MONID_INSPECT_SCHEMA_SHA256=
# Exact comma-separated artifact hosts; wildcards are not accepted.
MONID_ARTIFACT_HOST_ALLOWLIST=

# Required for live structured extraction. Public Q&A is evidence-only; the
# QA model identifier remains pinned in the provider contract for future use.
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-5.4-mini
OPENAI_QA_MODEL=gpt-5.4-mini
OPENAI_MAX_SERIALIZED_INPUT_BYTES=1200000
OPENAI_MAX_REQUEST_INPUT_BYTES=140000
OPENAI_MAX_INPUT_TOKENS=320000
OPENAI_MAX_OUTPUT_TOKENS=50000
OPENAI_RUN_RESERVE_MICRO_USD=495000
MONID_PARSE_RESERVE_MICRO_USD=4500

# Required in production. Local development falls back to an in-memory store.
DATABASE_URL=
# Non-secret owner binding used by the deployment-bound Workflow receipt.
# VERCEL_DEPLOYMENT_ID, VERCEL_URL, VERCEL_PROJECT_ID, VERCEL_ENV, and
# VERCEL_GIT_COMMIT_SHA are Vercel system variables.
RFP_XRAY_VERCEL_TEAM_ID=

# Vercel Private Blob. Vercel deployments can use project-scoped OIDC.
BLOB_READ_WRITE_TOKEN=
# Required alongside VERCEL_OIDC_TOKEN so the SDK can select the private store.
BLOB_STORE_ID=
# Set only after credentialed verification that allowOverwrite=false signed PUTs
# cannot replace the zero-byte replay fence written by the server.
BLOB_REPLAY_FENCE_VALIDATED=false

# Alternative private storage: a Railway S3-compatible Bucket. Production
# selects this provider when all five connection fields are present.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_URL_STYLE=virtual-host
# Exact comma-separated origins in the Bucket CORS policy. Wildcards are rejected.
S3_CORS_ALLOWED_ORIGINS=
# Non-secret, expiring output of the full bucket safety probe. It binds the
# canonical target, never-enabled versioning, absent/disabled Object Lock,
# replay/fence/deletion behavior, retained-version check, and CORS contract.
S3_SAFETY_ATTESTATION=
# Deprecated and ignored for Railway production readiness.
S3_REPLAY_FENCE_VALIDATED=false

# Public-demo abuse controls.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=
CRON_SECRET=
SESSION_SIGNING_SECRET=
IP_HASH_SECRET=
API_KEY_SHA256=

# Cost guardrails in USD micro-dollars.
MAX_RUN_COST_MICRO_USD=2000000
DAILY_COST_CAP_MICRO_USD=20000000
RUN_TTL_HOURS=24
GUEST_RUNS_PER_DAY=3
API_RUNS_PER_DAY=30
MAX_OUTSTANDING_UPLOAD_GRANTS=5
GUEST_UPLOAD_DOCUMENTS_PER_DAY=15
API_UPLOAD_DOCUMENTS_PER_DAY=150
GUEST_UPLOAD_BYTES_PER_DAY=393216000
API_UPLOAD_BYTES_PER_DAY=3932160000
GLOBAL_UPLOAD_BYTES_PER_DAY=5368709120

# Trusted absolute application origin for metadata and callbacks.
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
